{
  "name": "rescript-streaming-poc",
  "sources": [
    {
      "dir": "src",
      "subdirs": true
    }
  ],
  "package-specs": [
    {
      "module": "esmodule",
      "in-source": true,
      "suffix": ".res.js"
    }
  ],
  "bs-dependencies": [
    "@rescript/react",
    "@rescript/core",
    "bs-css",
    "bs-css-emotion"
  ],
  "bsc-flags": ["-open RescriptCore"],
  "jsx": {
    "version": 4,
    "module": "react"
  },
  "gentypeconfig": {
    "language": "typescript",
    "module": "esmodule",
    "suffix": ".res.js",
    "shims": {},
    "debug": {
      "all": false,
      "basic": false
    }
  }
}
